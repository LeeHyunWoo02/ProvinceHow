# backend.prod.env.example
#
#   cp backend.prod.env.example backend.prod.env   후 실제 값을 채운다.
#   backend.prod.env 는 절대 커밋하지 않는다 (.gitignore 등록됨).
#
#   사용: docker compose -f docker-compose.prod.yaml up -d --build
# ─────────────────────────────────────────────────────────────

# ── MySQL 컨테이너 초기화 ───────────────────────────────────
# 운영 비밀번호는 충분히 길게. dev 값을 재사용하지 않는다.
MYSQL_ROOT_PASSWORD=CHANGE_ME_root
MYSQL_DATABASE=smash_data
MYSQL_META_DB=smash_meta
MYSQL_USER=smash
MYSQL_PASSWORD=CHANGE_ME_app

# ── 애플리케이션 DataSource ─────────────────────────────────
# 호스트는 compose 서비스명 'mysql'. 컨테이너 네트워크 내부 주소다.
DRIVER=com.mysql.cj.jdbc.Driver

MYSQL_DATA_URL=jdbc:mysql://mysql:3306/smash_data?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Seoul&characterEncoding=UTF-8
MYSQL_DATA_USERNAME=smash
MYSQL_DATA_PASSWORD=CHANGE_ME_app

MYSQL_META_URL=jdbc:mysql://mysql:3306/smash_meta?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Seoul&characterEncoding=UTF-8
MYSQL_META_USERNAME=smash
MYSQL_META_PASSWORD=CHANGE_ME_app

# Spring Batch 메타 테이블 생성.
#   최초 배포(빈 mysql-data 볼륨)에서는 always.
#   테이블이 만들어진 뒤 재배포부터는 never 로 낮추는 것을 권장한다.
BATCH_SCHEMA_INIT=always

# ── Redis ───────────────────────────────────────────────────
# 컨테이너 Redis는 TLS를 쓰지 않는다.
# 외부 관리형 Redis(TLS 필수)로 옮길 때만 true 로 바꾼다.
REDIS_HOST=my-redis
REDIS_PORT=6379
REDIS_SSL=false

# ── 웹 ──────────────────────────────────────────────────────
SERVER_PORT=8080
# CORS 허용 오리진. 콤마로 여러 개 지정 가능 (SecurityConfig 가 String[] 로 받는다).
FRONT_URL=https://example.vercel.app

# ── 시드 배치 ───────────────────────────────────────────────
SEED_VERSION=prod-2026-08-10-1

SIDO_FILEPATH=/app/data/sido.csv
SIGUNGU_FILEPATH=/app/data/sigungu.csv
JOBCODETOP_FILEPATH=/app/data/level_top.csv
JOBCODEMIDDLE_FILEPATH=/app/data/level_middle.csv
INFRA_FILEPATH=/app/data/infra.csv
POPULATION_FILEPATH=
INDUSTRY_FILEPATH=
INFRASCORE_FILEPATH=
JOBCOUNT_FILEPATH=

# ── 공공데이터 API ──────────────────────────────────────────
MOLIT_BASE_URL=
MOLIT_PATH=
MOLIT_SERVICE_KEY=

YOUTH_BASE_URL=
YOUTH_BASE_PATH=
YOUTH_API_KEY=
