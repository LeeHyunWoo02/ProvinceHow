# =============================================================================
#  backend.env.example
#
#  이 파일을 backend.env 로 복사해서 값을 채운다. backend.env 는 커밋되지 않는다.
#
#      cp backend.env.example backend.env
#
#  ⚠️ 실제 인증키를 이 파일에 적지 마라. 여기 있는 값은 전부 자리표시자다.
#  ⚠️ 인증키에 가짜 기본값을 넣지 마라. 값이 없으면 비워 두면 된다 —
#     키가 빈 배치는 외부 API 를 호출하지 않고 "미적재" 경고만 남기고 건너뛴다.
#     애플리케이션은 정상 기동한다.
# =============================================================================


# -----------------------------------------------------------------------------
#  1. 외부 데이터 인증키  — 여기만 채우면 외부 데이터가 돈다
# -----------------------------------------------------------------------------

# 사람인(Saramin) 채용정보 오픈 API access-key. 채용 집계·링크의 기본(활성) 소스다.
#   발급: https://oapi.saramin.co.kr 회원가입 후 access-key 발급.
#   엔드포인트: GET https://oapi.saramin.co.kr/job-search (JSON).
#   ⚠️ 1일 최대 500회 호출 제한. 배치는 이 한도 안에서 운영해야 한다.
#   ⚠️ access-key 만 있으면 API 호출·페이징·전체건수·공고 id 파싱은 동작하지만,
#      정상 '집계'는 saramin loc_cd/job_cd → 우리 코드 매핑표를 채워야 한다.
#      매핑표(src/main/resources/saramin/saramin-job-api.json)가 비면 전부 unresolved 로 버려진다.
SARAMIN_ACCESS_KEY=

# 공공데이터포털(data.go.kr) 공통 인증키. (워크넷 채용정보는 이제 레거시다) LOCALDATA 가 쓴다.
#   발급: https://www.data.go.kr 회원가입 → 아래 각 API 페이지에서 "활용신청"(자동승인)
#     - 워크넷 채용정보 : https://www.data.go.kr/data/3038225/openapi.do  (레거시: JOB_PROVIDER=worknet 일 때만)
#     - LOCALDATA 업종별: https://www.data.go.kr/ 에서 "지방행정 인허가" 검색 후 업종별 신청
#   ⚠️ 인증키는 계정당 하나지만 활용신청은 API 마다 따로 해야 한다.
#   ⚠️ Encoding/Decoding 두 종류가 발급된다. URL 인코딩되지 않은 Decoding 키를 넣어라.
DATA_GO_KR_SERVICE_KEY=

# 국토교통부 아파트 전월세 실거래가. data.go.kr 키와 별개로 관리해도 되고 같아도 된다.
#   발급: https://www.data.go.kr/data/15126474/openapi.do
MOLIT_SERVICE_KEY=
MOLIT_BASE_URL=https://apis.data.go.kr/1613000
MOLIT_PATH=/RTMSDataSvcAptRent/getRTMSDataSvcAptRent

# KOSIS 통계 API (시군구 인구). data.go.kr 이 아니라 kosis.kr 자체 서비스라 키가 따로다.
#   발급: https://kosis.kr/openapi/ 회원가입 후 즉시 발급(심사 없음)
#   행정구역 코드를 그대로 주는 유일한 공식 출처라 채택했다. docs/external-api-spec.md 참고.
KOSIS_API_KEY=
KOSIS_BASE_URL=https://kosis.kr/openapi
KOSIS_ORG_ID=101
KOSIS_TABLE_ID=DT_1B040A3
KOSIS_ITEM_ID=T20

# 청년정책(온통청년)
YOUTH_API_KEY=
YOUTH_BASE_URL=
YOUTH_BASE_PATH=

# OpenAI
OPENAI_API_KEY=
OPENAI_URL=
OPENAI_MODEL=
OPENAI_TEMPERATURE=


# -----------------------------------------------------------------------------
#  2. 배치 on/off 와 주기
#     전부 꺼져 있는 것이 기본이다. 값을 주기 전에는 정기 배치가 돌지 않는다.
#     최초 구동 시 seedMasterJob 은 이 값과 무관하게 한 번 돈다.
# -----------------------------------------------------------------------------

# 기동 시 시드 배치(seedMasterJob) 실행 여부. 끄면 기준 데이터가 적재되지 않는다.
SEED_MASTER_ENABLED=true

# 필수 기준 데이터(시도/시군구/직종코드)의 재실행 제어. 값을 올리면 다시 적재한다.
#   외부 갱신 데이터는 이 값이 아니라 기준일/기준월로 판정하므로,
#   SEED_VERSION 이 그대로여도 월별·일별 갱신은 정상 동작한다.
SEED_VERSION=v1

# 인구 — 월 1회
POPULATION_BATCH_ENABLED=false
POPULATION_BATCH_CRON=0 10 4 1 * *

# 업종 마스터 + 인프라(LOCALDATA) — 일 1회
LOCALDATA_BATCH_ENABLED=false
LOCALDATA_BATCH_CRON=0 20 3 * * *

# 일자리 수 배치 — 일 1회.
#   WORKNET_JOB_BATCH_ENABLED: true 면 외부 API 로 적재(활성 provider 는 JOB_PROVIDER 가 정한다),
#   false 면 레거시 CSV 로 적재. 이름에 worknet 이 남아 있지만 provider 중립 스위치다.
WORKNET_JOB_BATCH_ENABLED=false
WORKNET_JOB_BATCH_CRON=0 0 3 * * *

# 전월세 — 월 1회
DWELLING_BATCH_ENABLED=false
DWELLING_BATCH_CRON=0 0 6 5 * *


# -----------------------------------------------------------------------------
#  3. 배치 세부 설정  — 기본값으로 두어도 동작한다
# -----------------------------------------------------------------------------

# 전월세 기준월 자동 계산
#   현재월(Asia/Seoul)에서 LAG 만큼 물러난 달을 쓰고, 그 달이 확정 0건이면 직전 달로 내려간다.
#   임대차 신고기한 30일 + "익일 공개" 정책상 2개월이 안전하다(docs/external-api-spec.md).
DWELLING_CONFIRMED_LAG_MONTHS=2
DWELLING_LOOKBACK_MONTHS=12
DWELLING_MAX_FALLBACK_MONTHS=3
DWELLING_BASE_MONTH_PROBE_ENABLED=true
DWELLING_BASE_MONTH_PROBE_REGION=11110
# 기준월을 수동으로 고정할 때만 채운다(yyyyMM). 비우면 위 규칙으로 자동 계산한다.
DWELLING_DEAL_YMD_OVERRIDE=

# 국토부 API 호출 제어 (totalCount 기반 페이지네이션)
MOLIT_PAGE_SIZE=1000
MOLIT_MAX_PAGES=50
MOLIT_REQUEST_INTERVAL_MS=100
MOLIT_MAX_CONCURRENT_REQUESTS=1

# KOSIS 재시도 / fallback
KOSIS_PERIOD_CODE=M
KOSIS_JSON_VD=
KOSIS_RETRY_MAX_ATTEMPTS=3
KOSIS_RETRY_BACKOFF_MILLIS=1000
KOSIS_FALLBACK_MONTHS=3

# 채용정보 provider 스위치. saramin(기본) | worknet.
#   활성 JobPostingProvider / JobListingLinkProvider 구현을 고른다.
JOB_PROVIDER=saramin

# 사람인 채용정보 API (활성 소스)
SARAMIN_BASE_URL=https://oapi.saramin.co.kr
SARAMIN_PATH=/job-search
SARAMIN_MAX_ATTEMPTS=3
SARAMIN_RETRY_DELAY_MS=1000
# 사람인 loc_cd/job_cd → 우리 코드 매핑표를 채운 뒤 정상 집계된다(saramin-job-api.json 상단 주석 참조).
SARAMIN_SPEC_PATH=classpath:saramin/saramin-job-api.json
# 지역 상세에 보여줄 개별 채용공고 카드 수. 1일 500회 제한 때문에 작게 둔다.
SARAMIN_VACANCY_LIST_SIZE=5
# 사람인 채용 목록 링크(외부 API 아님. 사용자에게 보여줄 검색 URL 을 조립한다)
SARAMIN_LISTING_BASE_URL=https://www.saramin.co.kr
SARAMIN_LISTING_PATH=/zf_user/jobs/list/domestic

# 워크넷 채용정보 API — 레거시. JOB_PROVIDER=worknet 일 때만 활성.
WORKNET_API_BASE_URL=https://openapi.work.go.kr
WORKNET_API_PATH=/opi/opi/opia/wantedApi.do
WORKNET_API_MAX_ATTEMPTS=3
WORKNET_API_RETRY_DELAY_MS=1000
WORKNET_JOB_PAGE_SIZE=100
WORKNET_JOB_MAX_PAGES=1000
WORKNET_JOB_DEDUPE_ENABLED=true
WORKNET_JOB_RESET_MISSING_TO_ZERO=true
# 인증키 수령 후 실제 응답의 지역·직종 필드명을 확인해 이 파일을 고친다(docs/worknet-job-api.md §10).
WORKNET_JOB_SPEC_PATH=classpath:worknet/worknet-job-api.json

# LOCALDATA 수집
LOCALDATA_API_BASE_URL=https://apis.data.go.kr
# API 는 100건/요청 × 10,000회/일 제한이라 전국 수집이 어렵다. 예산 초과 시 수집을 실패로 끝낸다.
LOCALDATA_DAILY_CALL_BUDGET=9000
# API(기본) / BULK_CSV(최초 시드·대규모 재적재 권장) / LEGACY_CSV(레거시 파일)
INFRA_COLLECT_SOURCE=API
# ratio 단위. PERCENT(0~100, 기본) 또는 FRACTION(0~1). docs/localdata-infra.md 참고.
INFRA_RATIO_BASIS=PERCENT
INFRA_INDUSTRY_MASTER=classpath:infra/industry-master.yml
INFRA_REGION_MAPPING=classpath:infra/localdata-region-mapping.yml

# 워크넷 채용 목록 링크 생성용(외부 API 아님. 사용자에게 보여줄 검색 URL 을 조립한다)
WORKNET_BASE_URL=https://www.work24.go.kr
WORKNET_PATH=/wk/a/b/1200/retriveDtlEmpSrchList.do


# -----------------------------------------------------------------------------
#  4. 시드 CSV 경로
#     정적 파일은 읽기 전용 마운트, 생성 파일은 쓰기 가능 마운트다(docker-compose.yaml).
# -----------------------------------------------------------------------------

SIDO_FILEPATH=/app/data/static/sido.csv
SIGUNGU_FILEPATH=/app/data/static/sigungu.csv
JOBCODETOP_FILEPATH=/app/data/static/level_top.csv
JOBCODEMIDDLE_FILEPATH=/app/data/static/level_middle.csv

# 레거시 경로 — 기본 수집 경로가 아니다. 비워 두는 것이 정상이다.
#   INDUSTRY_FILEPATH : 업종 마스터를 YAML 대신 파일로 덮어쓸 때만
#   INFRA_FILEPATH    : INFRA_COLLECT_SOURCE=LEGACY_CSV 일 때만
#   JOBCOUNT_FILEPATH : 워크넷 API 대신 CSV 로 적재할 때만
INDUSTRY_FILEPATH=
INFRA_FILEPATH=
JOBCOUNT_FILEPATH=


# -----------------------------------------------------------------------------
#  5. 인프라 (DB / Redis / 서버)
# -----------------------------------------------------------------------------

SERVER_PORT=8080
FRONT_URL=http://localhost:3000
DRIVER=com.mysql.cj.jdbc.Driver

# 배치 메타 스키마 생성. 최초 1회만 always 로 올렸다가 never 로 되돌린다.
BATCH_SCHEMA_INIT=never

# MySQL 컨테이너 초기화 (docker-compose 의 mysql 서비스가 읽는다)
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=smash
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_META_DB=smash_meta

# 애플리케이션이 붙는 두 DataSource
MYSQL_META_URL=jdbc:mysql://mysql:3306/smash_meta?serverTimezone=Asia/Seoul&characterEncoding=UTF-8
MYSQL_META_USERNAME=
MYSQL_META_PASSWORD=
MYSQL_DATA_URL=jdbc:mysql://mysql:3306/smash?serverTimezone=Asia/Seoul&characterEncoding=UTF-8
MYSQL_DATA_USERNAME=
MYSQL_DATA_PASSWORD=

REDIS_HOST=my-redis
REDIS_PORT=6379
REDIS_SSL=false


# -----------------------------------------------------------------------------
#  6. 레이트 리밋
# -----------------------------------------------------------------------------

RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_ALLOWED_COUNT=30
RATE_LIMIT_LOCK_TTL_MS=60000
RATE_LIMIT_SECRET=


# =============================================================================
#  더 이상 쓰지 않는 변수 (있어도 무시된다)
#
#    DEALYMD             → DWELLING_DEAL_YMD_OVERRIDE 로 바뀌었고, 이제 선택 사항이다.
#                          기준월은 자동 계산된다.
#    POPULATION_FILEPATH → 인구는 CSV 가 아니라 KOSIS API 로 적재한다.
#    WORK24_API_KEY      → 쓰지 않는다.
#    WORK24_API_BASE_URL → 쓰지 않는다.
#    WORK24_CRAWLER_*    → 고용24 공개검색 수집은 약관·저작권정책상 폐기됐다.
#                          WORKNET_JOB_BATCH_* 를 쓴다. docs/work24-crawling-assessment.md 참고.
# =============================================================================
