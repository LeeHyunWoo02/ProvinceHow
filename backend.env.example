# backend.env.example
#
#   cp backend.env.example backend.env   후 값을 채운다.
#   backend.env 는 커밋하지 않는다 (.gitignore 등록됨).
#
# docker-compose 의 backend / mysql 두 서비스가 이 파일 하나를 공유한다.
# ─────────────────────────────────────────────────────────────

# ── MySQL 컨테이너 초기화 (mysql 서비스가 사용) ──────────────
MYSQL_ROOT_PASSWORD=rootpw
MYSQL_DATABASE=smash_data
MYSQL_META_DB=smash_meta
MYSQL_USER=smash
MYSQL_PASSWORD=smashpw

# ── 애플리케이션 DataSource (backend 서비스가 사용) ──────────
# 호스트명은 compose 서비스명 'mysql'. localhost 가 아니다.
DRIVER=com.mysql.cj.jdbc.Driver

MYSQL_DATA_URL=jdbc:mysql://mysql:3306/smash_data?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Seoul&characterEncoding=UTF-8
MYSQL_DATA_USERNAME=smash
MYSQL_DATA_PASSWORD=smashpw

MYSQL_META_URL=jdbc:mysql://mysql:3306/smash_meta?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Seoul&characterEncoding=UTF-8
MYSQL_META_USERNAME=smash
MYSQL_META_PASSWORD=smashpw

# Spring Batch 메타 테이블 생성.
#   빈 meta 스키마로 처음 뜰 때는 반드시 always 여야 한다.
#   테이블이 만들어진 뒤에는 never 로 낮춰도 된다.
BATCH_SCHEMA_INIT=always

# ── Redis ───────────────────────────────────────────────────
REDIS_HOST=my-redis
REDIS_PORT=6379

# ── 웹 ──────────────────────────────────────────────────────
SERVER_PORT=8080
FRONT_URL=http://localhost:5173

# ── 시드 배치 ───────────────────────────────────────────────
# 올릴 때마다 9개 Seed 배치가 전부 다시 실행된다 (BatchGuard 기준값).
SEED_VERSION=2026-08-10-1

# CSV 경로. 컨테이너 기준 (compose 가 ./data 를 /app/data 로 마운트).
# 프로퍼티에 data/... 기본값이 있어 생략 가능하지만 명시를 권장한다.
SIDO_FILEPATH=/app/data/sido.csv
SIGUNGU_FILEPATH=/app/data/sigungu.csv
JOBCODETOP_FILEPATH=/app/data/level_top.csv
JOBCODEMIDDLE_FILEPATH=/app/data/level_middle.csv
INFRA_FILEPATH=/app/data/infra.csv
# 아직 파일이 없어 배치가 비활성(seed.jobs.*.enabled=false)인 항목
POPULATION_FILEPATH=
INDUSTRY_FILEPATH=
INFRASCORE_FILEPATH=
JOBCOUNT_FILEPATH=

# ── 공공데이터 API ──────────────────────────────────────────
MOLIT_BASE_URL=
MOLIT_PATH=
MOLIT_SERVICE_KEY=

YOUTH_BASE_URL=
YOUTH_BASE_PATH=
YOUTH_API_KEY=
