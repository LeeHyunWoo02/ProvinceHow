# 백엔드 앞단 리버스 프록시. Let's Encrypt 인증서 발급과 갱신을 Caddy가 자동으로 처리한다.
# 발급 조건: api.jibang.info 의 A 레코드가 이 서버 공인 IP를 가리키고,
#            80/443 이 OCI 보안목록과 인스턴스 iptables 양쪽에서 열려 있어야 한다.
{
	# 인증서 만료 경고 메일을 받으려면 주석을 풀고 주소를 넣는다. 없어도 발급은 된다.
	# email you@example.com
}

api.jibang.info {
	# backend 컨테이너는 외부에 포트를 열지 않고 compose 내부 네트워크로만 접근한다.
	# X-Forwarded-For / -Proto / -Host 는 reverse_proxy 가 자동으로 붙인다.
	reverse_proxy backend:8080

	encode gzip

	log {
		output stdout
		format console
	}
}

# Grafana 대시보드. api.jibang.info 와 같은 서버·같은 Caddy 가 인증서를 발급한다.
# 발급 조건이 동일하다: grafana.jibang.info 의 A 레코드가 이 서버 공인 IP 를 가리켜야 한다.
# A 레코드가 없으면 Caddy 가 이 사이트의 인증서 발급을 반복 실패한다(api 쪽은 영향 없음).
grafana.jibang.info {
	# grafana 컨테이너도 포트를 publish 하지 않는다. 외부 진입점은 여기 하나뿐이다.
	reverse_proxy grafana:3000

	encode gzip

	log {
		output stdout
		format console
	}
}
