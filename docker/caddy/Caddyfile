# 백엔드 앞단 리버스 프록시. Let's Encrypt 인증서 발급과 갱신을 Caddy가 자동으로 처리한다.
# 발급 조건: api.jibang.info 의 A 레코드가 이 서버 공인 IP를 가리키고,
#            80/443 이 OCI 보안목록과 인스턴스 iptables 양쪽에서 열려 있어야 한다.
{
	# 인증서 만료 경고 메일을 받으려면 주석을 풀고 주소를 넣는다. 없어도 발급은 된다.
	# email you@example.com
}

api.jibang.info {
	# backend 컨테이너는 외부에 포트를 열지 않고 compose 내부 네트워크로만 접근한다.
	# X-Forwarded-For / -Proto / -Host 는 reverse_proxy 가 자동으로 붙인다.
	reverse_proxy backend:8080

	encode gzip

	log {
		output stdout
		format console
	}
}
